<% content_for :title, "Solicitudes de Servicio" %>
<% input_class = "w-full px-3 py-2.5 border border-gray-300 rounded-lg bg-white focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all" %>
<% label_class = "block text-xs font-medium text-gray-600 mb-1" %>
<% status_classes = {
  "pending" => "bg-amber-100 text-amber-800",
  "approved" => "bg-blue-100 text-blue-800",
  "rejected" => "bg-red-100 text-red-800",
  "executed" => "bg-emerald-100 text-emerald-800"
} %>

<div class="w-full px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8">
  <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div class="flex items-start gap-4">
      <div class="flex items-center justify-center w-14 h-14 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 shadow-lg">
        <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
        </svg>
      </div>
      <div>
        <h1 class="font-bold text-3xl text-gray-900">Solicitudes de Servicio</h1>
        <p class="text-sm text-gray-500 mt-1">Gestión y seguimiento de solicitudes de Lázaro Cárdenas</p>
      </div>
    </div>
    <%= link_to bl_house_line_service_requests_path(request.query_parameters.except("page").merge(format: :xlsx)), class: "inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg border border-emerald-200 bg-white text-emerald-700 hover:bg-emerald-50 text-sm font-semibold shadow-sm transition-all" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0l-4-4m4 4l4-4M5 17v2a2 2 0 002 2h10a2 2 0 002-2v-2"/>
      </svg>
      Exportar XLSX
    <% end %>
  </div>

  <section class="bg-white rounded-xl shadow-md border border-gray-200 p-5 mb-6" aria-labelledby="filters-heading">
    <div class="flex items-center gap-2 mb-4">
      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      <h2 id="filters-heading" class="text-sm font-semibold text-gray-700 uppercase tracking-wider">Filtros de búsqueda</h2>
    </div>
    <%= form_with url: bl_house_line_service_requests_path, method: :get, class: "w-full", data: { turbo: false } do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div>
          <%= f.label :date_type, "Tipo de fecha", class: label_class %>
          <%= f.select :date_type, options_for_select([["Fecha requerida", "requested_date"], ["Fecha programada", "scheduled_date"], ["Fecha de solicitud", "created_at"]], params[:date_type]), {}, class: input_class %>
        </div>
        <div>
          <%= f.label :start_date, "Desde", class: label_class %>
          <%= f.date_field :start_date, value: params[:start_date], class: input_class %>
        </div>
        <div>
          <%= f.label :end_date, "Hasta", class: label_class %>
          <%= f.date_field :end_date, value: params[:end_date], class: input_class %>
        </div>
        <div>
          <%= f.label :status, "Estado", class: label_class %>
          <%= f.select :status, options_for_select([["Todos los estados", ""]] + BlHouseLineServiceRequest::STATUS_LABELS.map { |value, label| [label, value] }, params[:status]), {}, class: input_class %>
        </div>
        <div>
          <%= f.label :service_catalog_id, "Servicio", class: label_class %>
          <%= f.collection_select :service_catalog_id, @service_catalogs, :id, :display_name, { include_blank: "Todos los servicios", selected: params[:service_catalog_id] }, { class: input_class } %>
        </div>
        <div>
          <%= f.label :customs_agent_id, "Agencia aduanal", class: label_class %>
          <%= f.collection_select :customs_agent_id, @customs_agents, :id, :name, { include_blank: "Todas las agencias", selected: params[:customs_agent_id] }, { class: input_class } %>
        </div>
        <div>
          <%= f.label :blhouse, "BL House", class: label_class %>
          <%= f.text_field :blhouse, value: params[:blhouse], placeholder: "Buscar BL House...", class: input_class %>
        </div>
        <div>
          <%= f.label :container, "Contenedor", class: label_class %>
          <%= f.text_field :container, value: params[:container], placeholder: "Buscar contenedor...", class: input_class %>
        </div>
      </div>
      <div class="flex flex-wrap gap-3 mt-5">
        <%= f.submit "Filtrar", class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all cursor-pointer" %>
        <%= link_to "Limpiar filtros", bl_house_line_service_requests_path, class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 text-sm font-semibold transition-all" %>
      </div>
      <% active_filters_present = %i[status service_catalog_id customs_agent_id blhouse container start_date end_date].any? { |key| params[key].present? } %>
      <% if active_filters_present %>
        <div class="pt-4 mt-4 border-t border-gray-200">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-2 text-sm text-gray-600 flex-wrap">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-medium">Filtros activos:</span>
              <% if params[:status].present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Estado: <%= BlHouseLineServiceRequest::STATUS_LABELS.fetch(params[:status], params[:status]) %></span>
              <% end %>
              <% if params[:service_catalog_id].present? %>
                <% selected_service = @service_catalogs.find { |service| service.id.to_s == params[:service_catalog_id].to_s } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">Servicio: <%= selected_service&.display_name || params[:service_catalog_id] %></span>
              <% end %>
              <% if params[:customs_agent_id].present? %>
                <% selected_agency = @customs_agents.find { |agency| agency.id.to_s == params[:customs_agent_id].to_s } %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800">Agencia: <%= selected_agency&.name || params[:customs_agent_id] %></span>
              <% end %>
              <% if params[:blhouse].present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-100 text-sky-800">BL House: <%= params[:blhouse] %></span>
              <% end %>
              <% if params[:container].present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">Contenedor: <%= params[:container] %></span>
              <% end %>
              <% if params[:start_date].present? || params[:end_date].present? %>
                <% date_label = { "requested_date" => "Fecha requerida", "scheduled_date" => "Fecha programada", "created_at" => "Fecha de solicitud" }.fetch(params[:date_type].presence || "requested_date") %>
                <% date_bounds = [] %>
                <% date_bounds << "desde #{params[:start_date]}" if params[:start_date].present? %>
                <% date_bounds << "hasta #{params[:end_date]}" if params[:end_date].present? %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800"><%= date_label %>: <%= date_bounds.join(" ") %></span>
              <% end %>
            </div>
            <%= link_to bl_house_line_service_requests_path, class: "text-sm text-blue-600 hover:text-blue-800 font-medium inline-flex items-center gap-1" do %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Quitar filtros
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-gray-900">Solicitudes</h2>
    <span class="text-sm text-gray-500"><%= @requests.total_count %> resultados</span>
  </div>

  <% if @requests.any? %>
    <div class="hidden lg:block bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <% ["Servicio", "BL House / contenedor", "Agencia", "Estado", "Fechas"].each do |heading| %>
                <th scope="col" class="px-5 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider"><%= heading %></th>
              <% end %>
            </tr>
          </thead>
          <% @requests.each do |service_request| %>
            <tbody class="border-t border-gray-200" data-request-id="<%= service_request.id %>">
              <tr class="hover:bg-gray-50">
                <td class="px-5 py-4 text-sm font-semibold text-gray-900"><%= service_request.service_catalog.display_name %></td>
                <td class="px-5 py-4 text-sm text-gray-700">
                  <%= link_to service_request.bl_house_line.blhouse, bl_house_line_path(service_request.bl_house_line), class: "font-semibold text-indigo-700 hover:text-indigo-900" %>
                  <div class="text-xs text-gray-500 mt-1"><%= service_request.bl_house_line.container&.number || "Sin contenedor" %></div>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700"><%= service_request.customs_agent.name %></td>
                <td class="px-5 py-4">
                  <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= status_classes.fetch(service_request.status) %>"><%= BlHouseLineServiceRequest::STATUS_LABELS.fetch(service_request.status) %></span>
                </td>
                <td class="px-5 py-4 text-sm text-gray-700">
                  <p>Requerida: <%= service_request.requested_date %></p>
                  <p class="mt-1">Programada: <%= service_request.scheduled_date || "Pendiente" %> <%= service_request.scheduled_time&.strftime("%H:%M") %></p>
                  <p class="mt-1 text-xs text-gray-500">Solicitada: <%= l(service_request.created_at, format: :short) %></p>
                  <% if service_request.executed_at.present? %><p class="mt-1 text-xs text-gray-500">Ejecutada: <%= l(service_request.executed_at, format: :short) %></p><% end %>
                </td>
              </tr>
              <tr>
                <td colspan="5" class="px-5 pb-4">
                  <%= render "review_actions", service_request: service_request, prefix: "desktop" %>
                </td>
              </tr>
            </tbody>
          <% end %>
        </table>
      </div>
    </div>

    <div class="lg:hidden space-y-4">
      <% @requests.each do |service_request| %>
        <article class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 space-y-4" data-request-id="<%= service_request.id %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="font-semibold text-gray-900"><%= service_request.service_catalog.display_name %></h3>
              <%= link_to service_request.bl_house_line.blhouse, bl_house_line_path(service_request.bl_house_line), class: "text-sm font-medium text-indigo-700 hover:text-indigo-900" %>
            </div>
            <span class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= status_classes.fetch(service_request.status) %>"><%= BlHouseLineServiceRequest::STATUS_LABELS.fetch(service_request.status) %></span>
          </div>
          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div><dt class="text-xs text-gray-500">Contenedor</dt><dd class="text-gray-700"><%= service_request.bl_house_line.container&.number || "Sin contenedor" %></dd></div>
            <div><dt class="text-xs text-gray-500">Agencia</dt><dd class="text-gray-700"><%= service_request.customs_agent.name %></dd></div>
            <div><dt class="text-xs text-gray-500">Fecha requerida</dt><dd class="text-gray-700"><%= service_request.requested_date %></dd></div>
            <div><dt class="text-xs text-gray-500">Fecha programada</dt><dd class="text-gray-700"><%= service_request.scheduled_date || "Pendiente" %> <%= service_request.scheduled_time&.strftime("%H:%M") %></dd></div>
            <div><dt class="text-xs text-gray-500">Solicitada</dt><dd class="text-gray-700"><%= l(service_request.created_at, format: :short) %></dd></div>
            <% if service_request.executed_at.present? %><div><dt class="text-xs text-gray-500">Ejecutada</dt><dd class="text-gray-700"><%= l(service_request.executed_at, format: :short) %></dd></div><% end %>
          </dl>
          <%= render "review_actions", service_request: service_request, prefix: "mobile" %>
        </article>
      <% end %>
    </div>
    <div class="mt-6"><%= render "shared/tailwind_pagination", paginated: @requests %></div>
  <% else %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-10 text-center">
      <svg class="w-12 h-12 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="mt-4 font-semibold text-gray-700">No se encontraron solicitudes</p>
      <p class="mt-1 text-sm text-gray-500">Prueba ajustar los filtros de búsqueda.</p>
    </div>
  <% end %>
</div>
